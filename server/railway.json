{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "preDeployCommand": ["npm run migrate --workspace @props/server"],
    "startCommand": "cd server && exec node --import tsx src/main.ts",
    "healthcheckPath": "/v1/health",
    "healthcheckTimeout": 60,
    "numReplicas": 1,
    "drainingSeconds": 15,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
