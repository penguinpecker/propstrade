# Props.trade server environment. Every variable the server core reads; values are never committed.
# Required variables must be set or the process refuses to start.

# Postgres connection string (required).
DATABASE_URL=

# Exact origin of the web app, no path or trailing slash, e.g. https://props.trade (required).
# Used for CORS, the sign-in message domain/URI and the cross-site request check. The API must be served from the
# same site (e.g. api.props.trade) so the SameSite=Lax session cookie reaches it.
APP_ORIGIN=

# At least 32 random characters; keys the session-token hashes (required). Rotating it signs everyone out.
SESSION_SECRET=

# At least 32 random characters; bearer token for /v1/admin/* (required).
ADMIN_API_TOKEN=

# Solana JSON-RPC HTTP endpoint, e.g. a Helius mainnet URL (required).
RPC_URL=

# Solana RPC websocket endpoint (optional; derived from RPC_URL when unset).
RPC_WS_URL=

# mainnet-beta (default) or localnet; sets the sign-in chain id.
SOLANA_CLUSTER=

# Leave unset in production. NODE_ENV=test together with SOLANA_CLUSTER=localnet enables the local rehearsal's
# price-pin route (PUT /v1/test/prices/:symbol, admin token); it is never registered on mainnet-beta.
NODE_ENV=

# props_vault program id (optional until the program is deployed; /v1/me omits the trader profile without it). When set it must
# equal the id @props/sdk is built for, or the chain module refuses to start.
PROGRAM_ID=

# Listen address (defaults 8080 and 0.0.0.0; Railway sets PORT).
PORT=
HOST=

# fatal | error | warn | info (default) | debug | trace
LOG_LEVEL=

# Number of reverse proxies in front of the server whose X-Forwarded-For is trusted (default 1 = Railway edge).
TRUST_PROXY_HOPS=

# Sim engine: delay in ms between an order (or its last change) and the first price tick it may fill on; GMTrade keepers
# take about 2 s (default 2000, minimum 1000).
SIM_FILL_DELAY_MS=

# Signing keys for the chain and keeper modules: 64-byte secret key as base58 or a JSON byte array.
# Loaded only by modules that sign; never logged. Create them with scripts/admin/gen-authority-key.ts.
# RISK_AUTHORITY_KEYPAIR signs keeper transactions and evaluation/payout jobs; KYC_AUTHORITY_KEYPAIR signs set_identity.
RISK_AUTHORITY_KEYPAIR=
KYC_AUTHORITY_KEYPAIR=

# Keeper alerts (all optional; alerts are always logged). Telegram bot token and the chat it posts to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Pinged after every completed keeper tick (at most every 30 s), e.g. a Better Stack heartbeat URL.
HEARTBEAT_URL=
# Sentry DSN for warning and critical keeper alerts.
SENTRY_DSN=

# Last-deploy slot of the reviewed GMTrade program release (its ProgramData account, bytes 4..12). On a fresh database
# any other deploy is treated as an unreviewed upgrade: funded accounts are restricted until an operator acknowledges it.
# Unset: the first deploy the keeper sees is accepted, with a warning alert.
GMTRADE_DEPLOY_SLOT=

# Tests only: a disposable database whose name contains _test; it is dropped and recreated on every run.
TEST_DATABASE_URL=
