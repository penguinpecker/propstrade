{
  "name": "@props/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "dev": "tsx watch --env-file=.env src/main.ts",
    "migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:modules",
    "test:modules": "node --import tsx --test 'src/modules/**/*.test.ts'"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@noble/curves": "^2.4.0",
    "@props/gmsol-wasm": "*",
    "@props/gmtrade": "*",
    "@props/shared": "*",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
