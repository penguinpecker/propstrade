{
  "name": "@props/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "dev": "tsx watch --env-file=.env src/main.ts",
    "migrate": "tsx src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:modules",
    "test:modules": "node --import tsx --test --test-concurrency=1 'src/modules/**/*.test.ts'"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@noble/curves": "^2.4.0",
    "@props/gmsol-wasm": "*",
    "@props/gmtrade": "*",
    "@props/sdk": "*",
    "@props/shared": "*",
    "@solana/web3.js": "^3.1.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.14",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
