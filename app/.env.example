# Props.trade app build settings. Vite inlines these at build time; none of them is a secret.

# Base URL of the Props.trade API, without a trailing slash. Required for builds (the API is deployed
# separately). Must be same-site with the app (for example api.<app domain>) so the SameSite=Lax session
# cookie is sent. Empty is allowed only for the dev server, which then calls its own origin.
VITE_API_URL=

# Solana JSON-RPC endpoint used by the browser. Required on mainnet-beta: the public endpoint
# answers 403 to browser requests, so use a provider URL restricted to the app's domain.
# Empty on localnet = http://127.0.0.1:8899.
VITE_RPC_URL=

# props_vault program id. When set, the app refuses to sign in if the API reports a different program.
VITE_PROGRAM_ID=

# mainnet-beta (default) or localnet. Must match the API's /v1/config cluster.
VITE_CLUSTER=
